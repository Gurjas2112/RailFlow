# RailFlow environment — copy to .env and fill in. .env is gitignored; never commit it.

# Demo accounts created by `python -m railflow.manage seed-demo` (min 12 chars each)
RAILFLOW_VIEWER_PASSWORD=
RAILFLOW_CONTROLLER_PASSWORD=
RAILFLOW_ADMIN_PASSWORD=

# SQLite file (default: data/railflow.db)
RAILFLOW_DB=

# Allowed Origins for non-GET requests, comma-separated (default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000)
RAILFLOW_ALLOWED_ORIGINS=

# 1 = serve web/dist from the API process (single-process demo mode, set by start.ps1 / start.sh)
RAILFLOW_SERVE_WEB=

# 1 = add the Secure flag to the session cookie (only behind HTTPS)
RAILFLOW_SECURE_COOKIE=

# Local Ollama (never exposed beyond localhost)
RAILFLOW_OLLAMA_URL=
RAILFLOW_OLLAMA_MODEL=

# 1 = enable local speech-to-text (faster-whisper small, CPU int8) if installed
RAILFLOW_STT=

# 0 = skip the one dummy LLM call at startup that loads the model (default 1)
RAILFLOW_WARMUP=
